---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {% if page.github or page.zenodo or page.paper1 %}
      <div class="project-summary">
        <ul>
          {% if page.paper1 %}
            <li>
              {% if page.paper1 != 'todo' %}
                <a href="{{ '/publications/' | relative_url }}#{{ page.paper1 }}" title="paper" target="_blank" rel="nofollow">
                  <i class="fa-solid fa-scroll"></i><span>{{ page.paper1_description }}</span>
                </a>
              {% else %}
                <a title="paper" target="_blank" rel="nofollow">
                  <i class="fa-solid fa-scroll"></i><span>{{ page.paper1_description }}</span>
                </a>
              {% endif %}
            </li>
          {% endif %}

          {% if page.paper2 %}
            <li>
              <a href="{{ '/publications/' | relative_url }}#{{ page.paper2 }}" title="paper" target="_blank" rel="nofollow">
                <i class="fa-solid fa-scroll"></i><span>{{ page.paper2_description }}</span>
              </a>
            </li>
          {% endif %}

          {% if page.github %}
            <li>
              {% if page.github != 'todo' %}
                <a href="https://github.com/{{ page.github }}" title="github" target="_blank" rel="nofollow">
                  <i class="fa-brands fa-github"></i><span>{{ page.github }}</span>
                </a>
              {% else %}
                <a title="github" target="_blank" rel="nofollow"> <i class="fa-brands fa-github"></i><span>Coming soon!</span> </a>
              {% endif %}
            </li>
          {% endif %}

          {% if page.github2 %}
            <li>
              {% if page.github2 != 'todo' %}
                <a href="https://github.com/{{ page.github2 }}" title="github" target="_blank" rel="nofollow">
                  <i class="fa-brands fa-github"></i><span>{{ page.github2 }}</span>
                </a>
              {% else %}
                <a title="github" target="_blank" rel="nofollow"> <i class="fa-brands fa-github"></i><span>Coming soon!</span> </a>
              {% endif %}
            </li>
          {% endif %}

          {% if page.zenodo %}
            <li>
              <a href="https://doi.org/{{ page.zenodo }}" title="zenodo" target="_blank" rel="nofollow">
                <i class="ai ai-zenodo"></i><span>Artifact</span>
              </a>
            </li>
          {% endif %}

          {% if page.artifact %}
            <li>
              <a href="{{ page.artifact }}" title="artifact" target="_blank" rel="nofollow">
                <i class="fa-solid fa-box-archive"></i><span>Artifact</span>
              </a>
            </li>
          {% endif %}

          {% if page.docker %}
            <li>
              <a href="https://hub.docker.com/r/{{ page.docker }}" title="docker" target="_blank" rel="nofollow">
                <i class="fa-brands fa-docker"></i><span>{{ page.docker }}</span>
              </a>
            </li>
          {% endif %}
        </ul>
      </div>
    {% endif %}
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.plugins contains 'al_comments' %}
    {% include plugins/al_comments.liquid %}
  {% endif %}
</div>
